{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v zellij >/dev/null && [ -n \"$ZELLIJ_PANE_ID\" ] && zellij pipe --name \"cockpit::attention::working::$ZELLIJ_PANE_ID\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v zellij >/dev/null && [ -n \"$ZELLIJ_PANE_ID\" ] && zellij pipe --name \"cockpit::attention::waiting::$ZELLIJ_PANE_ID\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v zellij >/dev/null && [ -n \"$ZELLIJ_PANE_ID\" ] && zellij pipe --name \"cockpit::attention::done::$ZELLIJ_PANE_ID\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
